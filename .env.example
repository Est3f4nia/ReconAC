# Unica configuracion de Docker Compose. No subir .env a Git.
DB_NAME=reconac
DB_USER=reconac
DB_PASSWD=
JWT_SECRET=
# 32 bytes en Base64. Conservar esta clave junto con el backup de PostgreSQL.
NVD_ENCRYPTION_KEY=
SEC_NAME=
SEC_PASSWD=
CACHE_TTL_HOURS=24
FRONTEND_PORT=3000
COOKIE_SECURE=false
# Vacio: localhost y 127.0.0.1 en FRONTEND_PORT.
CORS_ORIGINS=
