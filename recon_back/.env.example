# Database (PostgreSQL)
DB_URL=jdbc:postgresql:
DB_USER=
DB_PASSWD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Cache TTL (hours)
CACHE_TTL_HOURS=24

# 32 bytes aleatorios en Base64. No es la API key de NVD; conservar con la BD.
NVD_ENCRYPTION_KEY=

# Secreto aleatorio para firmar JWT: minimo 32 bytes UTF-8.
JWT_SECRET=

# Spring Security
SEC_NAME=
SEC_PASSWD=

# Flask Recon Modules API
MODULES_API_URL=http://localhost:5000