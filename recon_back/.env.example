# SOLO ejecucion nativa. Compose no lee este archivo.

# Postgre
# ejemplo: DB_URL=jdbc:postgresql://localhost:5432/reconac
DB_URL=jdbc:postgresql://
DB_USER=
DB_PASSWD=

REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_HOURS=24

# Key API NVD de NIST
NVD_ENCRYPTION_KEY=

# 32 bytes en Base64
JWT_SECRET=

# Spring Security
SEC_NAME=
SEC_PASSWD=

# Flask
MODULES_API_URL=http://localhost:5000
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
